<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Completion_Percent__c</fullName>
    <formula>IF(BLANKVALUE(Planned_Quantity__c, 0) &gt; 0,
   BLANKVALUE(Completed_Quantity__c, 0) / Planned_Quantity__c,
   0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Share of the planned quantity that has been completed. Calculated automatically from Completed Quantity and Planned Quantity.</inlineHelpText>
    <label>Completion Percent</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
